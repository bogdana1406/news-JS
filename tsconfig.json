{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["DOM", "ES2020"],
        "strict": true,
        "noImplicitAny": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "src/**/*.js"]
}
